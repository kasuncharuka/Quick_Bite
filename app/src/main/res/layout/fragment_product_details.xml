<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/md_theme_background"
    tools:context=".fragment.ProductDetailsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/product_details_bottom_bar"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/product_image_slider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_image_fade" />


                <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                    android:id="@+id/dotsIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    app:dotsColor="#80FFFFFF"
                    app:selectedDotColor="@color/md_theme_primary"
                    app:dotsSize="8dp"
                    app:dotsSpacing="4dp" />

            </FrameLayout>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="-20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <TextView
                        android:id="@+id/product_details_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Grilled Chicken Burger"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:lineSpacingExtra="2dp" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <RatingBar
                            android:id="@+id/product_details_rating"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:rating="4.5"
                            android:progressTint="@color/md_theme_primary"
                            android:progressBackgroundTint="@color/md_theme_outlineVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="4.5 (200+ reviews)"
                            android:textSize="13sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                        <TextView
                            android:id="@+id/product_details_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LKR 2,500"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_primary" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

             <androidx.cardview.widget.CardView
                android:id="@+id/product_details_attribute_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customize"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_onSurface"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/product_details_attribute_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <!-- Label -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quantity"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available: "
                                android:textSize="13sp"
                                android:textColor="@color/md_theme_onSurfaceVariant" />

                            <TextView
                                android:id="@+id/product_details_avb_qty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_primary" />

                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_qty_stepper"
                        android:padding="4dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/product_details_btn_minus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="−"
                            android:textSize="20sp"
                            android:textColor="@color/md_theme_primary"
                            android:background="@drawable/bg_qty_btn"
                            android:padding="0dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/product_details_qty"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textAlignment="center"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/product_details_btn_plus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:textColor="@color/md_theme_onPrimary"
                            android:background="@drawable/bg_qty_btn_filled"
                            android:padding="0dp"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <include
                android:id="@+id/product_details_top_sell_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/item_section" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <LinearLayout
        android:id="@+id/product_details_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/md_theme_surface"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="12dp">


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/product_details_btn_add_cart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Order"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/md_theme_primary"
            android:background="@drawable/bg_btn_outline_primary"
            android:foreground="?android:attr/selectableItemBackground" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/product_details_btn_buy_now"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Call Now"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/md_theme_onPrimary"
            android:background="@drawable/bg_btn_filled_primary"
            android:foreground="?android:attr/selectableItemBackground" />

    </LinearLayout>

</RelativeLayout>