<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"

    tools:ignore="ExtraText">
    <TextView
        android:id="@+id/item_section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="top Selling"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/item_section_containerr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        tools:ignore="ExtraText" />


    <androidx.recyclerview.widget.RecyclerView android:id="@+id/item_section_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:clipToPadding="false"/>

</LinearLayout>